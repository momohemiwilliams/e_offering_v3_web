{
    "compilerOptions": {
        "target": "ES2020",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "strict": true,
        "jsx": "react-jsx",
        "isolatedModules": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "noEmit": true,
        "lib": ["ES2021", "DOM", "DOM.Iterable"],
        "types": ["vite/client", "node"],
        "baseUrl": ".",
        "paths": { "@/*": ["src/*"] }
    },
    "include": ["src/**/*.ts", "src/**/*.tsx"]
}
